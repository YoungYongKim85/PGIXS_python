# App icon assets -- real tracked files, not generated test/output imagery.
!pgixs_python/Intrologo.png
!packaging/icon_master.png

# Manual figures (docs/desktop_manual_ko.md/.docx) -- real tracked
# placeholder/screenshot assets, not generated test/output imagery.
!docs/figures/*.png

# Packaged detector masks -- shipped resources read at load time (and
# bundled by packaging/pgixs.spec), not local measurement data.
!pgixs_python/processing/data/*.mat

# Real beamline datasets used for local manual testing (~19GB) -- never
# meant to be tracked, only individual *.h5/*.mat above were being ignored
# so the folder itself still showed as untracked.
testdata/

# Claude Code local session state (absolute local paths, PIDs, temp-dir
# permissions accumulated during this machine's sessions) -- not shared
# project config, unlike .claude/launch.json.
.claude/settings.local.json

# Generated by examples/make_example_data.py; regenerate rather than commit.
examples/data/
